#!/usr/bin/env sh
set -e

# https://github.com/kvaps/kubectl-use, Apache License

case $1 in
-* | "")
  echo
  echo "  Usage:"
  echo "    kubectl use <context>"
  echo
  exit 1
  ;;
esac

for context in $(kubectl config get-contexts -o name); do
  if [ "$1" = "$context" ]; then
    new_context="$1"
    break
  fi
done

if [ -n "$new_context" ]; then
  kubectl config use "$1"
else
  echo "Can not swith context \"$1\"."
  exit 1
fi
