// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
	"diff_view_style": "split",
	"cli_default_open_behavior": "existing_window",
	"git_panel": {
		"dock": "left",
	},
	"on_last_window_closed": "platform_default",
	"when_closing_with_no_tabs": "close_window",
	"colorize_brackets": true,
	"vim_mode": false,
	"middle_click_paste": false,
	"sticky_scroll": {
		"enabled": true,
	},
	"title_bar": {
		"show_branch_icon": false,
		"show_branch_name": false,
		"show_project_items": true,
		"show_menus": false,
	},
	"collaboration_panel": {
		"dock": "left",
		"button": false,
	},
	"outline_panel": {
		"dock": "left",
		"folder_icons": true,
	},
	"tabs": {
		"file_icons": false,
	},
	"search": {
		"regex": true,
	},
	"minimap": {
		"show": "auto",
	},
	"icon_theme": "Zed (Default)",
	"wrap_guides": [80],
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_size": null,
	"edit_predictions": {
		"provider": "zed",
		"disabled_globs": [".env", "ARTICLE.md"],
	},
	"agent": {
		"dock": "right",
		"inline_assistant_model": {
			"provider": "anthropic",
			"model": "claude-opus-4-6-thinking-latest",
		},
		"single_file_review": true,
		"default_profile": "write",
		"profiles": {},
		"default_model": {
			"provider": "anthropic",
			"model": "claude-opus-4-5-thinking-latest",
		},
	},
	"format_on_save": "on",
	"base_keymap": "VSCode",
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"theme": {
		"mode": "system",
		"light": "Gruvbox Light",
		"dark": "Gruvbox Dark Hard",
	},
	"languages": {
		"JSONC": {
			"format_on_save": "off",
			"hard_tabs": true,
		},
		"Helm": {
			"tab_size": 2,
		},
		"HTML": {
			"format_on_save": "off",
		},
		"Markdown": {
			"format_on_save": "off",
			"soft_wrap": "preferred_line_length",
		},
		"HCL": {
			"format_on_save": "on",
			"tab_size": 2,
		},
		"C": {
			"format_on_save": "off",
			"hard_tabs": false,
			"tab_size": 2,
			"preferred_line_length": 100,
		},
		"C++": {
			"format_on_save": "off",
			"hard_tabs": false,
			"tab_size": 2,
		},
		"Rust": {
			"format_on_save": "off",
		},
		"JavaScript": {
			"format_on_save": "off",
		},
		"TypeScript": {
			"format_on_save": "off",
		},
		"JSON": {
			"format_on_save": "on",
		},
		"YAML": {
			"tab_size": 2,
			"format_on_save": "off",
		},
		"Python": {
			"wrap_guides": [120],
			// "language_servers": [
			//   // Disable basedpyright and enable ty, and otherwise
			//   // use the default configuration.
			//   "ty",
			//   "!basedpyright",
			//   "...",
			// ],
		},
	},
	"file_types": {
		"Helm": [
			"**/templates/**/*.tpl",
			"**/templates/**/*.yaml",
			"**/templates/**/*.yml",
			"**/helmfile.d/**/*.yaml",
			"**/helmfile.d/**/*.yml",
			"**/values*.yaml",
		],
		"Dockerfile": ["**/Dockerfile", "**/Dockerfile.*"],
	},
	"lsp": {
		"clangd": {},
		"ruff": {
			"initialization_options": {
				"settings": {
					"lineLength": 120,
				},
			},
		},
	},
	"terminal": {
		"working_directory": "current_project_directory",
		"max_scroll_history_lines": 50000,
		"dock": "bottom",
		"copy_on_select": true,
	},
	"project_panel": {
		"dock": "left",
		"hide_root": true,
		"auto_fold_dirs": true,
	},
	"preview_tabs": {
		"enabled": false,
	},
	"ssh_connections": [
		{
			"host": "tsukihi",
			"projects": [
				{
					"paths": ["~/hw"],
				},
			],
		},
	],
}
